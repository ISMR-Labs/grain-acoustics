# Claude API key (required for answers): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model + effort for spoken answers
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low
# Wake word(s), comma separated
WAKE_WORDS=oracle,hey oracle,the oracle
# Whisper model: tiny.en | base.en | small | medium (bigger = slower, more accurate)
WHISPER_MODEL=small
# Piper voice, downloaded on first start (e.g. en_US-lessac-medium, en_GB-alan-medium, en_US-amy-medium)
PIPER_VOICE=en_US-lessac-medium
# Optional Home Assistant control (create a long-lived token in HA: Profile -> Security)
HA_URL=http://192.168.1.8:8123
HA_TOKEN=
# Where the assistant lives (used for time/weather context)
ASSISTANT_TZ=Asia/Colombo
ASSISTANT_LOCATION=Colombo, Sri Lanka
